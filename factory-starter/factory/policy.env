# Highest risk tier the factory may auto-merge once CI is green.
#   none  every pull request waits for you (use this for the first two weeks)
#   R0    docs, copy, work records
#   R1    ordinary changes inside existing boundaries
# R2 always needs the 'human-approved' label. R3 is never done by the factory.
AUTO_MERGE_MAX_TIER=none

# How much ceremony a feature gets before and while it is built (team mode).
#   full  planning has a specialist review round (threat model, data review) and up to 2
#         discussion rounds and 3 drafts; acceptance criteria get an evidence review and, at R2
#         with sample files, a security review, and any user-visible decision without a
#         criterion blocks; build items wait for the e2e tests written from the criteria
#   mvp   for a first version: one discussion round, no specialist review round, one draft;
#         at most 15 acceptance criteria, one evidence review, and only a criterion that is
#         wrong, untestable or contradicts a record blocks; build items start at dispatch and
#         the e2e tests come at integration
# The same in both: secrets scan, ownership, CI, risk tiers, your label on R2, security review
# of R2 builds and of research briefs. Anything but "mvp" means full.
RIGOR=full
